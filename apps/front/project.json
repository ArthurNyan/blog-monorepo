{
  "name": "front",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "root": "apps/front",
  "sourceRoot": "apps/front/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm dev",
        "cwd": "apps/front"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm build",
        "cwd": "apps/front"
      },
      "outputs": ["{projectRoot}/dist", "{projectRoot}/.astro"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm preview",
        "cwd": "apps/front"
      }
    },
    "generate:api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm generate:api",
        "cwd": "apps/front"
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm smoke:acceptance",
        "cwd": "apps/front"
      }
    },
    "evidence:testing": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm evidence:testing",
        "cwd": "."
      }
    },
    "audit:browser": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm audit:browser",
        "cwd": "."
      },
      "outputs": [
        "{workspaceRoot}/thesis/knowledge/diploma/evidence-artifacts/browser-baseline-audit.json"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Standalone lint orchestration is not separated for front; use build, smoke, evidence:testing, and audit:browser.'",
        "cwd": "apps/front"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm smoke:acceptance",
        "cwd": "apps/front"
      }
    }
  }
}
