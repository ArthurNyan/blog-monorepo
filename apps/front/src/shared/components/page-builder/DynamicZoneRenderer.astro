---
import type { PageBlock } from "@/shared/api/pages";
import type { SiteLocale } from "@/shared/i18n/config";
import PageBlockRenderer from "@/shared/components/page-builder/PageBlock.astro";

interface Props {
	blocks: PageBlock[];
	locale?: string;
	siteLocale?: SiteLocale;
	pagePath?: string;
	pageTitle?: string;
}

const { blocks, locale, siteLocale, pagePath, pageTitle } = Astro.props as Props;
---

<>
	{blocks.map((block, index) => (
		<PageBlockRenderer
			block={block}
			locale={locale}
			siteLocale={siteLocale}
			pagePath={pagePath}
			pageTitle={pageTitle}
			key={`${block.__component}-${index}`}
		/>
	))}
</>
