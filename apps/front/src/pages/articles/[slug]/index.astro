---
import { fetchArticleSlugs } from "@/shared/api/pages";
import {
	buildLocalizedCollectionPath,
	defaultSiteLocale,
} from "@/shared/i18n/config";

export const getStaticPaths = async () =>
	(await fetchArticleSlugs()).map((slug) => ({
		params: { slug },
	}));

const slug = Astro.params.slug;

if (!slug) {
	throw new Error("Article slug is required");
}

const redirectTo = buildLocalizedCollectionPath(
	defaultSiteLocale,
	"articles",
	slug
);
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
		<link rel="canonical" href={redirectTo} />
		<script is:inline>
			window.location.replace({JSON.stringify(redirectTo)});
		</script>
		<title>Redirecting…</title>
	</head>
	<body>
		<a href={redirectTo}>Перейти к локализованной статье</a>
	</body>
</html>
