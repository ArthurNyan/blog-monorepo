---
import {
	buildLocalizedCollectionPath,
	defaultSiteLocale,
} from "@/shared/i18n/config";

const redirectTo = buildLocalizedCollectionPath(defaultSiteLocale, "vacancies");
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
		<link rel="canonical" href={redirectTo} />
		<script is:inline>
			window.location.replace("/ru/vacancies/");
		</script>
		<title>Redirecting…</title>
	</head>
	<body>
		<a href={redirectTo}>Перейти к локализованному разделу вакансий</a>
	</body>
</html>
