---
import MainLayout from "@/layouts/main.astro";
import { Badge } from "@/shared/components/ui/badge";
import { MarkdownContent } from "@/shared/components/MarkdownContent";
import {
	fetchCmsVacancyBySlug,
	fetchCmsVacancySlugs,
} from "@/shared/api/vacancies-cms";
import {
	buildLocalizedCollectionPath,
	isSiteLocale,
	siteLocales,
	toCmsLocale,
} from "@/shared/i18n/config";
import {
	formatVacancySalary,
	getVacancyUiCopy,
} from "@/shared/i18n/vacancies";
import { buildSeoMetadata } from "@/shared/seo/metadata";
import { VacancyApplicationForm } from "@/widgets/VacancyApplicationForm";

export const getStaticPaths = async () => {
	const localizedPaths = await Promise.all(
		siteLocales.map(async (locale) => {
			const slugs = await fetchCmsVacancySlugs(toCmsLocale(locale));

			return slugs.map((slug) => ({
				params: { locale, slug },
			}));
		})
	);

	return localizedPaths.flat();
};

const locale = Astro.params.locale;
const { slug } = Astro.params;

if (!isSiteLocale(locale)) {
	throw new Error(`Unsupported locale: ${locale}`);
}

if (!slug) {
	throw new Error("Vacancy slug is required");
}

const copy = getVacancyUiCopy(locale);
const vacancy = await fetchCmsVacancyBySlug(slug, {
	locale: toCmsLocale(locale),
});

if (!vacancy) {
	return new Response(copy.notFoundMessage, { status: 404 });
}

const pathname = buildLocalizedCollectionPath(locale, "vacancies", slug);
const seo = buildSeoMetadata({
	seo: vacancy.seo,
	title: vacancy.title || copy.detailFallbackTitle,
	description:
		vacancy.description || vacancy.location || copy.detailFallbackDescription,
	pathname,
});
const salary = formatVacancySalary(vacancy, locale);
---

<MainLayout
	content={{
		title: vacancy.title || copy.detailFallbackTitle,
		description:
			vacancy.description || vacancy.location || copy.detailFallbackDescription,
		seo,
		pathname,
		locale,
		lang: locale,
		cmsStatus: "published",
	}}
	className="flex flex-col"
>
	<section class="container mx-auto px-4 py-10 md:py-14">
		<a
			href={buildLocalizedCollectionPath(locale, "vacancies")}
			class="inline-flex text-sm text-primary mb-6 hover:underline"
		>
			← {copy.backToListLabel}
		</a>

		<div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_460px] gap-8">
			<article class="space-y-6">
				<div class="space-y-4">
					<div class="flex flex-wrap gap-2">
						{
							vacancy.industry?.name && (
								<Badge variant="secondary">{vacancy.industry.name}</Badge>
							)
						}
						{
							vacancy.role?.name && (
								<Badge variant="outline">{vacancy.role.name}</Badge>
							)
						}
					</div>
					<h1 class="text-3xl md:text-5xl font-semibold leading-tight">
						{vacancy.title}
					</h1>
					<p class="text-lg text-muted-foreground">{vacancy.location}</p>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div class="rounded-xl border border-border bg-card/40 p-4">
						<div class="text-xs uppercase tracking-wide text-muted-foreground mb-1">
							{copy.workFormatLabel}
						</div>
						<div class="font-medium">
							{copy.workFormats[
								vacancy.workFormat as keyof typeof copy.workFormats
							] || vacancy.workFormat}
						</div>
					</div>
					<div class="rounded-xl border border-border bg-card/40 p-4">
						<div class="text-xs uppercase tracking-wide text-muted-foreground mb-1">
							{copy.employmentTypeLabel}
						</div>
						<div class="font-medium">
							{copy.employmentTypes[
								vacancy.employmentType as keyof typeof copy.employmentTypes
							] ||
								vacancy.employmentType}
						</div>
					</div>
					<div class="rounded-xl border border-border bg-card/40 p-4">
						<div class="text-xs uppercase tracking-wide text-muted-foreground mb-1">
							{copy.levelLabel}
						</div>
						<div class="font-medium">
							{copy.levels[vacancy.level as keyof typeof copy.levels] ||
								vacancy.level}
						</div>
					</div>
					<div class="rounded-xl border border-border bg-card/40 p-4">
						<div class="text-xs uppercase tracking-wide text-muted-foreground mb-1">
							{copy.salaryLabel}
						</div>
						<div class="font-medium">{salary}</div>
					</div>
				</div>

				{
					vacancy.description && (
						<div class="rounded-2xl border border-border bg-card/40 p-6">
							<h2 class="text-2xl font-semibold mb-4">
								{copy.detailDescriptionHeading}
							</h2>
							<MarkdownContent content={vacancy.description} />
						</div>
					)
				}
			</article>

			<aside class="rounded-2xl border border-border bg-card/50 p-6 h-max xl:sticky xl:top-24">
				<VacancyApplicationForm
					vacancyId={vacancy.documentId || vacancy.id || ""}
					vacancyTitle={vacancy.title}
					siteLocale={locale}
					client:load
				/>
			</aside>
		</div>
	</section>
</MainLayout>
